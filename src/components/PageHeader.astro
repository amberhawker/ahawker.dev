---
interface Props {
    command: string;
    title: string;
    lead?: string;
}

const { command, title, lead } = Astro.props;
---

<header class="pt-10 pb-8 sm:pt-14">
    <p class="text-sm break-words">
        <span class="font-bold text-paper">amber@ahawker.dev</span>:<span class="text-ink/70">~</span>$ {command}
    </p>
    <h1 class="mt-3 text-4xl font-bold sm:text-6xl">{title}</h1>
    {lead && <p class="mt-4 max-w-2xl text-base leading-relaxed sm:text-lg">{lead}</p>}
    <slot />
</header>
