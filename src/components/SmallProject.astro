---
import { Image } from 'astro:assets';

interface Img {
    path: string;
    alt: string;
}

interface Props {
    title: string;
    imgs: Array<Img>;
    shortDesc: string;
}

const {
    title = "",
    imgs = [{path: "", alt: ""}],
    shortDesc = "",
} = Astro.props;

---

<div class="project-card mockup-code bg-base-100 border border-base-300 w-full">
    <div class="flex flex-col xl:flex-row items-center justify-between px-6 pb-6 pt-2 md:px-8 md:pb-8 gap-6">
        <div class="flex flex-col items-center justify-center flex-1 w-full">
            <div class="relative w-full max-w-sm aspect-3/2 shrink-0 overflow-hidden rounded-xl">
                {imgs.map((img, index) => (
                    <img
                        alt={img.alt || title}
                        src={img.path}
                        width={600}
                        height={400}
                        class:list={[
                            "project-img rounded-box w-full h-full object-cover",
                            index > 0 && "hidden"
                        ]}
                    />
                ))}
                {imgs.length > 1 && (
                    <button
                        type="button"
                        class="next-btn btn btn-primary btn-sm absolute bottom-2 right-2 z-20 shadow-md"
                        aria-label="Next image"
                    >
                        ❯
                    </button>
                )}
            </div>
        </div>

        <div class="divider divider-horizontal hidden xl:flex self-stretch" />
        <div class="divider divider-vertical xl:hidden my-0 w-full" />

        <div class="flex flex-col justify-center text-left flex-1 min-w-0 p-2">
            <h3 class="text-2xl md:text-3xl font-bold mb-2">{title}</h3>
            <p class="text-base text-base-content/80 leading-relaxed">{shortDesc}</p>
        </div>
    </div>
</div>

<script>
    document.querySelectorAll('.project-card').forEach((card) => {
        const images = card.querySelectorAll<HTMLElement>('.project-img');
        const nextBtn = card.querySelector('.next-btn');
        if (!nextBtn || images.length <= 1) return;

        let currentIndex = 0;
        nextBtn.addEventListener('click', () => {
            images[currentIndex].classList.add('hidden');
            currentIndex = (currentIndex + 1) % images.length;
            images[currentIndex].classList.remove('hidden');
        });
    });
</script>