---
import Layout from '../layouts/Layout.astro';
import Window from '../components/Window.astro';
import Terminal from '../components/Terminal.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { profile, education, stack, links } from '../data/site';

const experience = (await getCollection('experience')).sort((a, b) => a.data.order - b.data.order);
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = projects.filter((project) => project.data.featured);
const others = projects.filter((project) => !project.data.featured);

const shortcuts = [
	{ label: 'about.txt', run: 'cat about.txt', icon: 'file' },
	{ label: 'projects/', run: 'ls projects', icon: 'folder' },
	{ label: 'stack.json', run: 'stack', icon: 'file' },
	{ label: 'contact.sh', run: './contact.sh', icon: 'exe' },
];
---

<Layout>
	<!-- Hero -->
	<section class="grid items-center gap-10 py-12 sm:py-16 lg:grid-cols-[1fr_1.15fr] lg:py-20">
		<div>
			<p class="inline-flex items-center gap-2 rounded-full border-2 border-ink bg-paper px-3 py-1 text-xs font-bold shadow-[2px_2px_0_var(--color-ink)]">
				<span class="h-2 w-2 animate-pulse rounded-full bg-mint ring-1 ring-ink"></span>
				{profile.base} · {profile.pronouns}
			</p>
			<h1 class="hero-title mt-5 text-5xl leading-none font-bold tracking-tight sm:text-7xl">{profile.name}</h1>
			<p class="mt-4 text-sm text-ink/85">{profile.roles.join(' / ').toLowerCase()}</p>
			<p class="mt-6 max-w-xl text-base leading-relaxed sm:text-lg">{profile.tagline}</p>

			<div class="mt-8 flex flex-wrap gap-3">
				<a href="/projects" class="btn btn-tactile bg-ink text-blush">ls ~/projects</a>
				<a href="/contact" class="btn btn-tactile bg-paper text-ink">./contact.sh</a>
			</div>

			<ul class="mt-10 flex flex-wrap gap-3 sm:gap-5" aria-label="Terminal shortcuts">
				{shortcuts.map((s) => (
					<li>
						<a href={`#${s.label.replace(/\W.*$/, '')}`} data-run={s.run} class="group flex w-20 flex-col items-center gap-1.5 text-center" title={`run: ${s.run}`}>
							<span class="flex h-12 w-12 items-center justify-center rounded-lg border border-ink/25 bg-paper/70 transition-all group-hover:-translate-y-1 group-hover:border-ink group-hover:bg-white group-hover:shadow-[2px_2px_0_var(--color-ink)]">
								{s.icon === 'folder' && (
									<svg class="h-8 w-8" viewBox="0 0 40 40" fill="none" aria-hidden="true"><path d="M5 11h11l3 4h16v18H5V11Z" fill="#FBB5B0" stroke="#3D080C" stroke-width="2" stroke-linejoin="round" /><path d="M5 17h30" stroke="#3D080C" stroke-width="2" /></svg>
								)}
								{s.icon === 'file' && (
									<svg class="h-8 w-8" viewBox="0 0 40 40" fill="none" aria-hidden="true"><path d="M8 4h17l8 8v24H8V4Z" fill="#FFF6F4" stroke="#3D080C" stroke-width="2" stroke-linejoin="round" /><path d="M25 4v8h8" fill="#FBB5B0" stroke="#3D080C" stroke-width="2" stroke-linejoin="round" /><path d="M13 18h13M13 23h15M13 28h8" stroke="#3D080C" stroke-width="2" stroke-linecap="round" /></svg>
								)}
								{s.icon === 'exe' && (
									<svg class="h-8 w-8" viewBox="0 0 40 40" fill="none" aria-hidden="true"><rect x="6" y="6" width="28" height="28" rx="2" fill="#3D080C" stroke="#3D080C" stroke-width="2" /><path d="M12 17l4 3-4 3" stroke="#4EF2BB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /><path d="M18 23h7" stroke="#FFD9D6" stroke-width="2" stroke-linecap="round" /></svg>
								)}
							</span>
							<span class="rounded px-1 text-xs font-bold group-hover:bg-ink group-hover:text-blush">{s.label}</span>
						</a>
					</li>
				))}
			</ul>
		</div>

		<Terminal />
	</section>

	<div class="flex flex-col gap-14">
		<!-- About -->
		<Window id="about" title="about.txt — less" command="cat about.txt">
			<div class="grid gap-8 md:grid-cols-[1fr_16rem]">
				<div class="flex flex-col gap-4 leading-relaxed">
					<h2 class="text-3xl font-bold sm:text-4xl">About</h2>
					{profile.about.map((p) => <p>{p}</p>)}
				</div>
				<dl class="self-start rounded-md border-2 border-ink bg-blush/60 p-4 text-xs leading-6">
					<dt class="font-bold text-hot">BASE</dt>
					<dd>{profile.base}</dd>
					<dt class="mt-3 font-bold text-hot">STUDYING</dt>
					<dd>{education.program}, {education.school}</dd>
					<dt class="mt-3 font-bold text-hot">FOCUS</dt>
					<dd>{profile.focus.join(' / ')}</dd>
					<dt class="mt-3 font-bold text-hot">PRONOUNS</dt>
					<dd>{profile.pronouns}</dd>
				</dl>
			</div>
			<p class="mt-6 text-right text-sm"><a href="/about" class="text-hot underline">more about me →</a></p>
		</Window>

		<!-- Experience -->
		<Window id="experience" title="experience.log — tail" command="cat experience.log" term>
			<h2 class="mb-6 text-3xl font-bold text-blush sm:text-4xl">Experience</h2>
			<ol class="flex flex-col gap-8 border-l border-blush/25 pl-5">
				{experience.map(({ id, data: role }) => (
					<li class="relative">
						<span class="absolute top-1.5 -left-[1.6rem] h-2.5 w-2.5 rounded-full bg-mint" aria-hidden="true"></span>
						<h3 class="text-xl font-bold text-blush">
							<a href={`/experience#${id}`} class="hover:text-mint">{role.title}</a> <span class="font-body text-sm font-normal text-rose">@ {role.org}</span>
						</h3>
						<p class="mt-2 max-w-3xl text-sm leading-relaxed text-blush/80">{role.summary}</p>
						<p class="mt-3 text-xs text-mint/90">{role.stack.join(' · ')}</p>
					</li>
				))}
				<li class="relative">
					<span class="absolute top-1.5 -left-[1.6rem] h-2.5 w-2.5 rounded-full bg-rose" aria-hidden="true"></span>
					<h3 class="text-xl font-bold text-blush">
						Student <span class="font-body text-sm font-normal text-rose">@ {education.school}</span>
					</h3>
					<p class="mt-2 text-sm text-blush/80">{education.program}</p>
				</li>
			</ol>
			<p class="mt-6 text-right text-sm"><a href="/experience" class="text-mint underline">full experience log →</a></p>
		</Window>

		<!-- Projects -->
		<section id="projects" class="flex flex-col gap-6">
			<div data-reveal>
				<p class="text-sm"><span class="font-bold text-paper">amber@ahawker.dev</span>:<span class="text-ink/70">~</span>$ ls ~/projects --featured</p>
				<h2 class="mt-2 text-3xl font-bold sm:text-4xl">Projects</h2>
			</div>
			<div class="grid gap-8 lg:grid-cols-2">
				{featured.map((project, i) => (
					<ProjectCard project={project} wide={i === 0} class={i === 0 ? 'lg:col-span-2' : undefined} />
				))}
			</div>

			<Window title="~/projects — ls -la" command="ls -la ~/projects --all" term class="mt-4">
				<ul class="flex flex-col divide-y divide-blush/10 text-sm">
					{others.map((project) => (
						<li class="grid gap-x-4 gap-y-1 py-3 sm:grid-cols-[9rem_12rem_1fr]">
							<span class="text-blush/45">drwxr-xr-x {project.data.year}</span>
							<a href={`/projects/${project.id}`} class="font-bold text-mint hover:underline">{project.id}/</a>
							<span class="text-blush/80">{project.data.shortDescription}</span>
						</li>
					))}
				</ul>
				<p class="mt-5 text-xs text-blush/55">
					<a href="/projects" class="text-mint underline">all projects with filters →</a> · more on <a href="https://github.com/amberhawker" class="text-rose underline" target="_blank" rel="noopener">github.com/amberhawker ↗</a>
				</p>
			</Window>
		</section>

		<!-- Stack -->
		<Window id="stack" title="stack.json — vim" command="cat stack.json" term>
			<h2 class="mb-5 text-3xl font-bold text-blush sm:text-4xl">Stack</h2>
			<pre class="overflow-x-auto text-sm leading-7"><code>{'{'}
{stack.map((g, i) => (
<span>  <span class="text-rose">"{g.group}"</span>: [{g.items.map((item, j) => <span><span class="text-mint">"{item}"</span>{j < g.items.length - 1 && ', '}</span>)}]{i < stack.length - 1 && ','}
</span>))}{'}'}</code></pre>
			<p class="mt-6 text-right text-sm"><a href="/stack" class="text-mint underline">where I use each tool →</a></p>
		</Window>

		<!-- Contact -->
		<Window id="contact" title="contact.sh — bash" command="./contact.sh">
			<div class="grid gap-8 md:grid-cols-[1fr_auto] md:items-end">
				<div>
					<h2 class="text-3xl font-bold sm:text-4xl">Let’s talk systems.</h2>
					<p class="mt-3 max-w-lg leading-relaxed text-ink/80">Interesting problem, project, or question? The fastest way to reach me is email.</p>
				</div>
				<ul class="flex flex-col gap-3 text-sm">
					{links.map((l) => (
						<li>
							<a
								href={l.href}
								target={l.href.startsWith('mailto:') ? undefined : '_blank'}
								rel={l.href.startsWith('mailto:') ? undefined : 'noopener'}
								class="btn btn-tactile w-full justify-start bg-paper text-ink normal-case"
							>
								<span class="w-20 shrink-0 text-left text-hot">{l.label}</span>
								<span class="truncate">{l.value}</span>
							</a>
						</li>
					))}
				</ul>
			</div>
		</Window>
	</div>
</Layout>

<script>
	import { animate, splitText, stagger } from 'animejs';

	const title = document.querySelector<HTMLElement>('.hero-title');
	if (title && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
		const { chars } = splitText(title, { chars: true });
		animate(chars, {
			translateY: [{ from: '1.5rem', to: '0rem', ease: 'outBounce', duration: 800 }],
			opacity: { from: 0, to: 1, duration: 300 },
			delay: stagger(40),
		});
	}
</script>

<style>
	.hero-title :global(span) {
		display: inline-block;
	}
</style>
