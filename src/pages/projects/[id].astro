---
import type { GetStaticPaths } from 'astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Window from '../../components/Window.astro';
import Slider from '../../components/Slider.astro';

export const getStaticPaths = (async () => {
	const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
	return projects.map((project, i) => ({
		params: { id: project.id },
		props: { project, prev: projects[i - 1], next: projects[i + 1] },
	}));
}) satisfies GetStaticPaths;

interface Props {
	project: CollectionEntry<'projects'>;
	prev?: CollectionEntry<'projects'>;
	next?: CollectionEntry<'projects'>;
}

const { project, prev, next } = Astro.props;
const { title, year, role, imgs, shortDescription, longDescription, highlights, tags, repo, live } = project.data;
---

<Layout title={title} description={shortDescription}>
	<div class="py-10 sm:py-14">
		<a href="/#projects" class="text-sm hover:text-hot">← cd ..</a>
		<Window
			title={`README.md — ~/projects/${project.id}`}
			command="cat README.md"
			path={`~/projects/${project.id}`}
			class="mt-4"
			bodyClass="flex flex-col gap-6"
			reveal={false}
		>
			<header>
				<p class="text-xs text-ink/60">{year}{role && ` · ${role}`}</p>
				<h1 class="mt-2 text-4xl font-bold sm:text-5xl"># {title}</h1>
				<p class="mt-4 max-w-3xl text-lg leading-relaxed">{shortDescription}</p>
			</header>

			<Slider imgs={imgs} class="aspect-[12/5] max-w-3xl" />

			<div class="flex max-w-3xl flex-col gap-4 leading-relaxed">
				{longDescription.split('\n\n').map((p) => <p>{p}</p>)}
			</div>

			{highlights.length > 0 && (
				<div>
					<h2 class="text-2xl font-bold">## Highlights</h2>
					<ul class="mt-3 flex flex-col gap-2 text-sm">
						{highlights.map((h) => (
							<li><span class="text-hot">-</span> {h}</li>
						))}
					</ul>
				</div>
			)}

			<div>
				<h2 class="text-2xl font-bold">## Stack</h2>
				<ul class="mt-3 flex flex-wrap gap-1.5">
					{tags.map((tag) => <li class="tag">{tag}</li>)}
				</ul>
			</div>

			{(repo || live) && (
				<div class="flex flex-wrap gap-3 border-t-2 border-dashed border-ink/20 pt-6 text-sm">
					{repo && <a href={repo} target="_blank" rel="noopener" class="btn btn-tactile bg-ink text-blush">source ↗</a>}
					{live && <a href={live} target="_blank" rel="noopener" class="btn btn-tactile bg-paper text-ink">live site ↗</a>}
				</div>
			)}
		</Window>

		<nav class="mt-8 flex flex-wrap justify-between gap-4 text-sm" aria-label="Other projects">
			{prev ? <a href={`/projects/${prev.id}`} class="hover:text-hot">← {prev.data.title}</a> : <span />}
			{next && <a href={`/projects/${next.id}`} class="hover:text-hot">{next.data.title} →</a>}
		</nav>
	</div>
</Layout>
