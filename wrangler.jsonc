{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "ahawker-dev",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-11-15",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist/client",
	},
	// Limits blog password attempts per client IP.
	"ratelimits": [
		{
			"name": "BLOG_LOGIN_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 5, "period": 60 },
		},
	],
	// Secrets: BLOG_PASSWORD, SESSION_SECRET
	// Locally in .dev.vars (see .dev.vars.example); in production via `wrangler secret put`.
}
